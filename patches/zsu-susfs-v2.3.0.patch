diff --git a/kernel/susfs/compat.c b/kernel/susfs/compat.c
new file mode 100644
index 0000000..eb8b232
--- /dev/null
+++ b/kernel/susfs/compat.c
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <linux/errno.h>
+#include <linux/cred.h>
+#include <linux/uidgid.h>
+#include <linux/uaccess.h>
+
+#include <linux/security.h>
+#include <linux/string.h>
+#include <linux/jump_label.h>
+
+/* SUSFS SID cache: this is deliberately independent of ZSU's native SID cache. */
+u32 susfs_init_sid __read_mostly;
+u32 susfs_zygote_sid __read_mostly;
+u32 susfs_zygote_next_sid __read_mostly;
+u32 susfs_priv_app_sid __read_mostly;
+u32 susfs_ksu_sid __read_mostly;
+
+u32 susfs_get_sid_from_name(const char *secctx_name)
+{
+    u32 sid = 0;
+    if (!secctx_name || security_secctx_to_secid(secctx_name, strlen(secctx_name), &sid))
+        return 0;
+    return sid;
+}
+
+bool susfs_is_sid_equal(const struct cred *cred, u32 sid2)
+{
+    u32 sid = 0;
+    if (!cred || !sid2)
+        return false;
+    security_cred_getsecid(cred, &sid);
+    return sid == sid2;
+}
+
+u32 susfs_get_current_sid(void)
+{
+    u32 sid = 0;
+    security_cred_getsecid(current_cred(), &sid);
+    return sid;
+}
+
+void susfs_set_batch_sid(void)
+{
+    susfs_zygote_sid = susfs_get_sid_from_name("u:r:zygote:s0");
+    susfs_zygote_next_sid = susfs_get_sid_from_name("u:r:zygote_next:s0");
+    susfs_ksu_sid = susfs_get_sid_from_name("u:r:ksu:s0");
+    susfs_init_sid = susfs_get_sid_from_name("u:r:init:s0");
+    susfs_priv_app_sid = susfs_get_sid_from_name("u:r:priv_app:s0:c512,c768");
+}
+
+bool susfs_is_current_zygote_domain(void)
+{ return susfs_is_sid_equal(current_cred(), susfs_zygote_sid); }
+bool susfs_is_current_zygote_next_domain(void)
+{ return susfs_is_sid_equal(current_cred(), susfs_zygote_next_sid); }
+bool susfs_is_current_ksu_domain(void)
+{ return susfs_is_sid_equal(current_cred(), susfs_ksu_sid); }
+#include "compat.h"
+#include "uapi/supercall.h"
+
+#if IS_ENABLED(CONFIG_KSU_SUSFS)
+
+int ksu_handle_sys_reboot(int magic1, int magic2, unsigned int cmd,
+                          void __user **arg)
+{
+    if (magic1 != KSU_INSTALL_MAGIC1 || magic2 != SUSFS_MAGIC)
+        return -EINVAL;
+
+    /* The stock tool is a privileged control plane.  Never broaden this to
+     * manager authentication: manager auth remains in the existing ioctl path. */
+    if (!uid_eq(current_euid(), GLOBAL_ROOT_UID))
+        return -EPERM;
+
+    switch (cmd) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+    case CMD_SUSFS_ADD_SUS_PATH:
+        susfs_add_sus_path(arg);
+        return 0;
+    case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+        susfs_add_sus_path_loop(arg);
+        return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+    case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+        susfs_set_hide_sus_mnts_for_non_su_procs(arg);
+        return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+    case CMD_SUSFS_ADD_SUS_KSTAT:
+    case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+        susfs_add_sus_kstat(arg);
+        return 0;
+    case CMD_SUSFS_UPDATE_SUS_KSTAT:
+        susfs_update_sus_kstat(arg);
+        return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+    case CMD_SUSFS_SET_UNAME:
+        susfs_set_uname(arg);
+        return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+    case CMD_SUSFS_ENABLE_LOG:
+        susfs_enable_log(arg);
+        return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+    case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+        susfs_set_cmdline_or_bootconfig(arg);
+        return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+    case CMD_SUSFS_ADD_OPEN_REDIRECT:
+        susfs_add_open_redirect(arg);
+        return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MAP
+    case CMD_SUSFS_ADD_SUS_MAP:
+        susfs_add_sus_map(arg);
+        return 0;
+#endif
+    case CMD_SUSFS_SET_PRIORITY_UID_FILTER:
+        susfs_set_priority_uid_filter(arg);
+        return 0;
+    case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+        susfs_set_avc_log_spoofing(arg);
+        return 0;
+    case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+        susfs_get_enabled_features(arg);
+        return 0;
+    case CMD_SUSFS_SHOW_VARIANT:
+        susfs_show_variant(arg);
+        return 0;
+    case CMD_SUSFS_SHOW_VERSION:
+        susfs_show_version(arg);
+        return 0;
+    default:
+        return -EINVAL;
+    }
+}
+
+#endif /* CONFIG_KSU_SUSFS */
diff --git a/kernel/susfs/compat.h b/kernel/susfs/compat.h
new file mode 100644
index 0000000..d8d9612
